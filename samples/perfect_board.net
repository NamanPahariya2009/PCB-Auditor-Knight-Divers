(export (version D)
  (components
    (comp (ref U1) (value "STM32_MCU") (footprint "LQFP-48") (pins (pin (num 1) (name VCC) (type power_in)) (pin (num 2) (name GND) (type power_in))))
    (comp (ref C1) (value "100nF") (footprint "0603") (pins (pin (num 1) (name ~) (type passive)) (pin (num 2) (name ~) (type passive))))
    (comp (ref PWR1) (value "3.3V_REG") (footprint "SOT-223") (pins (pin (num 1) (name OUT) (type power_out)) (pin (num 2) (name GND) (type power_out))))
  )
  (nets
    (net (code 1) (name "3.3V_RAIL")
      (node (ref U1) (pin 1))
      (node (ref C1) (pin 1))
      (node (ref PWR1) (pin 1)))
    (net (code 2) (name "GND")
      (node (ref U1) (pin 2))
      (node (ref C1) (pin 2))
      (node (ref PWR1) (pin 2)))
  )
)
