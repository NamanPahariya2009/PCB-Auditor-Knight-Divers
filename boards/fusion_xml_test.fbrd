<?xml version="1.0" encoding="utf-8"?>
<eagle version="9.6.2">
<drawing>
<board>
<elements>
<element name="U1" library="arduino" package="UNO" value="ARDUINO_UNO"/>
<element name="B1" library="power" package="BATT" value="BATTERY_9V"/>
<element name="R1" library="resistor" package="0805" value="10k"/>
</elements>
<signals>
<signal name="VCC">
<contactref element="B1" pad="POS"/>
<contactref element="U1" pad="VIN"/>
</signal>
<signal name="GND">
<contactref element="B1" pad="NEG"/>
<contactref element="U1" pad="GND"/>
<contactref element="R1" pad="1"/>
</signal>
</signals>
</board>
</drawing>
</eagle>
